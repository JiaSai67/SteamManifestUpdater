.card-dd::-webkit-scrollbar{width:4px}
.card-dd::-webkit-scrollbar-thumb{background:rgba(0,0,0,.22);border-radius:4px}
.app.dark .card-dd::-webkit-scrollbar-thumb{background:rgba(255,255,255,.25)}
#glist .card .card-menu{position:absolute;bottom:6px;right:6px;width:24px;height:24px;border-radius:50%;background:rgba(0,0,0,.45);color:#fff;cursor:pointer;border:none;z-index:4;display:flex!important;align-items:center!important;justify-content:center!important;padding:0!important;line-height:1;transition:background .2s,transform .15s}
#glist .card .card-menu:hover{background:var(--pink-deep);transform:scale(1.08)}
