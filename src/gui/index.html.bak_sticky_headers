/* ═══════════════════════════════════════════════════════
   圖四/圖五需求：全域現代極簡純拉條
   - 軌道底色與背景完全一致 (全透明，徹底去除刺眼白底)
   - 移除上下箭頭按鈕
   - 純膠囊滑塊造型 (圖五)
   - 滑動時平滑漸顯，停止滑動 0.25 秒後漸消
   ═══════════════════════════════════════════════════════ */
::-webkit-scrollbar,
*::-webkit-scrollbar {
  width: 6px !important;
  height: 6px !important;
  background: transparent !important;
}
::-webkit-scrollbar-track,
*::-webkit-scrollbar-track {
  background: transparent !important;
  border: none !important;
}
::-webkit-scrollbar-button,
*::-webkit-scrollbar-button {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}
::-webkit-scrollbar-corner,
*::-webkit-scrollbar-corner {
  background: transparent !important;
}
::-webkit-scrollbar-thumb,
*::-webkit-scrollbar-thumb {
  background-color: transparent !important;
  border-radius: 99px !important;
  transition: background-color .25s cubic-bezier(.16,1,.3,1) !important;
}

/* 滑動中 (.is-scrolling) 或滑鼠懸停拉條時漸顯純膠囊拉條 */
.is-scrolling::-webkit-scrollbar-thumb,
*.is-scrolling::-webkit-scrollbar-thumb,
::-webkit-scrollbar-thumb:hover,
*::-webkit-scrollbar-thumb:hover {
  background-color: rgba(130, 118, 122, 0.55) !important;
}
.app.dark .is-scrolling::-webkit-scrollbar-thumb,
.app.dark *.is-scrolling::-webkit-scrollbar-thumb,
.app.dark ::-webkit-scrollbar-thumb:hover,
.app.dark *::-webkit-scrollbar-thumb:hover {
  background-color: rgba(255, 255, 255, 0.38) !important;
}

