function onScDone(res){ scRender(res); }
function scRender(res){
  var btn = document.getElementById('sc-btn');
  _scBusy = false;
  if(btn){ btn.disabled = false; btn.textContent = '開始自檢'; }
  var sum = document.getElementById('sc-summary');
