.card-spinner{width:22px;height:22px;border:2.5px solid rgba(255,255,255,0.25);border-top-color:var(--pink-deep);border-radius:50%;animation:cardSpin .75s linear infinite;margin-bottom:6px}
@keyframes cardSpin{to{transform:rotate(360deg)}}
.card-update-status{font-size:11px;font-weight:600;color:#ffd700;text-shadow:0 1px 4px rgba(0,0,0,0.8)}
/* 管理頁列表 */
#glist.list{display:flex;flex-direction:column;gap:8px}
#glist.list .card{flex-direction:row;align-items:center;text-align:left;padding:10px 16px;border-radius:14px;min-height:68px;margin-bottom:0;overflow:visible!important;position:relative;gap:14px}
#glist.list .card img{width:116px;height:54px;border-radius:6px;object-fit:cover;flex-shrink:0;background:rgba(255,255,255,.1);order:-1}
#glist.list .card .name{font-size:13.5px;font-weight:600;padding:0;background:transparent!important;color:inherit;flex:1;min-width:0;border-radius:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#glist.list .card .aid{padding:0;background:transparent!important;border-radius:0;min-height:auto;display:inline-flex;align-items:center;gap:10px;margin:0 40px 0 auto;color:var(--gray)}
#glist.list .card .card-menu{position:absolute;top:50%;transform:translateY(-50%);right:12px;width:28px;height:28px;font-size:16px;line-height:28px}
#glist.list .card .card-dd{top:calc(50% + 18px);right:12px;bottom:auto}
#glist.list .dlc-card{margin-left:24px}

/* 下拉選單樣式優化（深淺色自適應） */
#view-mode{padding:5px 12px;border:1px solid var(--pink-light);border-radius:8px;font-size:11px;font-weight:600;font-family:var(--font);background:rgba(255,255,255,.85);color:#111827;cursor:pointer;outline:none;margin-left:auto;transition:all .2s ease}
#view-mode:hover{background:#FFF;border-color:var(--pink-deep)}
#view-mode option{background:#FFF!important;color:#111827!important}
.card .info{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:3px;text-align:left}
.card .name{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3}
.card .info .aid{font-size:11px!important;color:var(--gray,#888)!important;margin:0!important;background:transparent!important;border-radius:0!important;min-height:auto!important;padding:0!important;display:inline-block!important;text-align:left!important;letter-spacing:0.2px!important;font-variant-numeric:tabular-nums!important}
.card .ver-info{font-size:10px;color:var(--pink-deep);margin:0 6px 3px;cursor:default;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* 🌟 依需求：「在 Steam 商店查看」僅在文字上可點擊，禁止整行擴展 */
.card .link-wrap{display:inline-flex;align-self:flex-start;width:max-content;margin-top:2px}
.card .link{font-size:10.5px;color:var(--pink-deep);cursor:pointer;user-select:none;display:inline-flex;align-items:center;gap:3px;width:max-content}
.card .link:hover{text-decoration:underline;color:#FF4081}

/* 🌟 搜尋小卡標籤組 */
.search-tags-row{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin:2px 0}
.search-tag{display:inline-flex;align-items:center;padding:2px 7px;border-radius:6px;font-size:10px;font-weight:700;line-height:1.3;letter-spacing:0.2px}
.search-tag.tag-ver{background:rgba(0,188,212,0.12);color:#00BCD4;border:1px solid rgba(0,188,212,0.32)}
.search-tag.tag-of{background:rgba(76,175,80,0.14);color:#4CAF50;border:1px solid rgba(76,175,80,0.35)}
.search-tag.tag-none{background:rgba(255,255,255,0.08);color:var(--gray);border:1px solid rgba(255,255,255,0.12)}

/* 🌟 搜尋小卡操作區與轉圈讀取狀態 */
.search-action-wrap{display:flex;align-items:center;justify-content:flex-end;min-width:90px;margin-left:auto;flex-shrink:0}
.search-loading-spinner{width:18px;height:18px;border:2.5px solid rgba(255,143,167,0.25);border-top-color:var(--pink-deep);border-radius:50%;animation:searchSpin 0.75s linear infinite;margin:auto}
@keyframes searchSpin{to{transform:rotate(360deg)}}
.btn-unsupported{background:rgba(255,255,255,0.08)!important;color:#8A7E82!important;border:1px solid rgba(255,255,255,0.12)!important;cursor:not-allowed!important;box-shadow:none!important;opacity:0.75}
.app.dark .btn-unsupported{background:rgba(255,255,255,0.05)!important;color:#6A5E62!important;border-color:rgba(255,255,255,0.08)!important}
.tool-card{width:230px;height:200px;background:rgba(255,255,255,.45);border:1px solid rgba(255,255,255,.7);border-radius:18px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:16px;backdrop-filter:blur(14px) saturate(1.25);-webkit-backdrop-filter:blur(14px) saturate(1.25);box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 4px 18px rgba(61,44,46,.08)}
.tool-card .e{font-size:28px}.tool-card .tt{font-size:13px;font-weight:700;margin:6px 0 2px}.tool-card .ds{font-size:10px;color:var(--gray);margin-bottom:10px}
.tool-row{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:8px}
.path-row{display:flex;gap:6px;margin-bottom:10px}
.path-row input{flex:1;padding:8px 12px;border:1.5px solid var(--pink-light);border-radius:var(--rs);font-size:12px;font-family:var(--font);outline:none}
.path-row input:focus{border-color:var(--pink-deep)}
.section{font-size:14px;font-weight:700;margin:16px 0 6px}
.toggle{display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border)}
.toggle .l{font-size:12px}
.switch{position:relative;width:40px;height:22px;display:inline-block}
.switch input{opacity:0;width:0;height:0}
.switch span{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#E0D0D3;border-radius:22px;transition:.2s}
.switch span::before{content:"";position:absolute;height:16px;width:16px;left:3px;bottom:3px;background:white;border-radius:50%;transition:.2s}
.switch input:checked+span{background:var(--pink-deep)}
.switch input:checked+span::before{transform:translateX(18px)}
.about-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:12px 15px;margin-bottom:10px}
.about-card h4{font-size:13px;font-weight:700;margin-bottom:4px}
.about-card p{font-size:11px;color:var(--gray);line-height:1.6}
.toast{position:fixed;bottom:24px;right:24px;left:auto;top:auto;padding:11px 20px;border-radius:12px;font-size:12px;font-weight:600;color:var(--white);z-index:200000;opacity:0;pointer-events:none;transform:translateY(16px) scale(0.95);transition:all .28s cubic-bezier(0.16,1,0.3,1);max-width:380px;text-align:left;box-shadow:0 8px 28px rgba(0,0,0,.35);line-height:1.5;word-break:break-word;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.toast.show{opacity:1;pointer-events:auto;transform:translateY(0) scale(1)}
.toast.ok{background:rgba(46,125,50,.92);border:1px solid rgba(129,199,132,.4)}
.toast.er{background:rgba(198,40,40,.92);border:1px solid rgba(239,154,154,.4)}
.toast.wn{background:rgba(230,81,0,.92);border:1px solid rgba(255,183,77,.4)}
.toast.in{background:rgba(38,30,34,.92);border:1px solid rgba(255,255,255,.18)}
