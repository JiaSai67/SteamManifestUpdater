/* 首頁瀏覽全部（網格）— 尺寸放大，框線與管理頁網格對齐，文字黑色底色 */
#results.browse-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:14px}
#results.browse-grid .card{flex-direction:column;align-items:stretch;text-align:center;padding:0;overflow:visible!important;border-radius:14px;min-height:auto;position:relative;gap:0;height:auto}
