.modal.hidden, .hidden{display:none!important}
.modal>div{background:var(--white);border-radius:var(--r);padding:20px;min-width:300px;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,.15);max-height:calc(100vh - 24px);min-height:0;overflow-y:auto}
.modal h3{font-size:14px;margin-bottom:6px}
.modal p{font-size:11px;color:var(--gray);margin-bottom:12px}
.modal .btns{display:flex;gap:8px;justify-content:center}

.prog-box{min-width:320px}
#prog-bar{width:100%;height:8px;border-radius:8px;overflow:hidden;border:none;margin:4px 0}
#prog-bar::-webkit-progress-bar{background:#F0E0E4;border-radius:8px}
#prog-bar::-webkit-progress-value{background:linear-gradient(90deg,var(--pink-deep),#F090A8);border-radius:8px;transition:width .3s ease}
#prog-bar:indeterminate::-webkit-progress-bar{background:linear-gradient(90deg,var(--pink-deep),#F090A8,var(--pink-deep));background-size:200% 100%;animation:progInd 1.2s ease infinite}
@keyframes progInd{from{background-position:200% 0}to{background-position:-200% 0}}
#prog-step{font-size:11px;color:var(--gray);margin:0}
.empty{text-align:center;padding:40px 0;color:var(--gray);font-size:13px}
