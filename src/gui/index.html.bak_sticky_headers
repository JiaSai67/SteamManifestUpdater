@keyframes pulse{0%,100%{opacity:.5}50%{opacity:1}}
/* ── 頂級絲滑硬體加速動畫系統（GPU 合成，零 Blur，零 CPU 重繪） ── */
/* 卡片通用硬件加速與渲染隔離 */
.card {
  will-change: transform, opacity;
  transform: translateZ(0);
  backface-visibility: hidden;
  contain: layout style;
}

/* 卡片逐個入場（管理/搜尋/DLC 通用：自然微位移彈入，前 16 張輕盈錯開，最大延遲 0.28s） */
.card {
  animation: cardIn .26s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  animation-delay: calc(min(var(--i, 0), 16) * 0.016s);
}
@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(12px) translateZ(0);
  }
  to {
    opacity: 1;
    transform: translateY(0) translateZ(0);
  }
}

/* 首頁遊戲入庫網格專屬：頂級優雅微縮放浮入（徹底移除高消耗的高斯模糊 filter: blur） */
#results.browse-grid .card {
  animation: browseSmoothIn .32s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  animation-delay: calc(min(var(--i, 0), 18) * 0.018s);
}
@keyframes browseSmoothIn {
  0% {
    opacity: 0;
    transform: translateY(14px) scale(0.97) translateZ(0);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1) translateZ(0);
  }
}

/* 圖片平滑淡入加載（移除一切 filter: blur 濾鏡，僅走 GPU 透明度通道） */
.card img {
  opacity: 0;
  transition: opacity .25s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity;
  transform: translateZ(0);
}
.card img.i-ok {
  opacity: 1;
}

/* 圖片載入佔位：GPU 呼吸脈衝（杜絕 linear-gradient 的 background-position 重繪，CPU 負載降為 0） */
.card img:not(.i-ok) {
  background: rgba(255, 255, 255, 0.08);
  animation: gpuPulse 1.4s ease-in-out infinite alternate;
}
@keyframes gpuPulse {
  0% { opacity: 0.35; }
  100% { opacity: 0.75; }
}
