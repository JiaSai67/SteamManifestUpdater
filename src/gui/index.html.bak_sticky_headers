// 🌟 黃色醒目更新：單個更新與全部批次自動更新
// ═══════════════════════════════════════════════════════
async function autoUpdateSingle(appid, name){
  var aidStr = String(appid || '').trim();
  if(!aidStr){
    tt('❌ 更新失敗：無效或未提供 AppID', 'er', 4000);
    return;
  }
  var card = document.querySelector('#glist .card[data-appid="'+aidStr+'"]') || document.querySelector('#results .card[data-appid="'+aidStr+'"]');
  var ov = null;
  if(card){
    ov = document.createElement('div');
    ov.className = 'card-updating-overlay';
    ov.innerHTML = '<div class="card-spinner"></div><div class="card-update-status">正在下載 Manifest…</div>';
    card.appendChild(ov);
  } else {
    sp('正在更新 Manifest…', '「'+name+'」正在多源比對與下載…', 30, '請稍候…');
  }

  try {
    var res = await pywebview.api.auto_stock_after_import(aidStr, name);
    if(ov) ov.remove(); else cp();

    // 保存最後一次診斷紀錄
    if(res && (res.report_markdown || res.log_path)){
      window._lastManifestLog = res;
    }

    if(res && res.ok){
      if(!_knownUpdates) _knownUpdates = {};
      _knownUpdates[aidStr] = { appid: aidStr, has_update: false, version_status: '最新版' };

      // 🌟 即時同步消除搜尋列表中的「⚡ 更新 Manifest」按鈕與需更新黃光標記
      var sCard = document.querySelector('#results .card[data-appid="'+aidStr+'"]');
      if(sCard){
        sCard.classList.remove('needs-update');
        var sBtn = sCard.querySelector('.btn');
        if(sBtn){
          sBtn.outerHTML = '<button class="btn btn-o btn-s" style="color:var(--succ);border-color:var(--succ);cursor:default" onclick="event.stopPropagation()">✅ 已在本地</button>';
        }
        var upTag = sCard.querySelector('.tag-up');
        if(upTag) upTag.remove();
      }

      if(_pre._games){
        _pre._games.forEach(function(g){
          if(String(g.appid) === aidStr){
            g.has_update = false;
            g.version_status = '最新版';
          }
        });
        _pre._games.sort(function(a,b){ return (b.has_update?1:0) - (a.has_update?1:0); });
        var filter = (document.getElementById('mf').value||'').trim().toLowerCase();
        renderGames(_pre._games, filter);
      }
      var isFallback = res.msg && (res.msg.indexOf('Ryuu') > -1 && res.msg.indexOf('Lua.tools') > -1);
      if(isFallback){
        tt('⚡ 「'+name+'」' + res.msg + ' <a href="javascript:openManifestLogModal()" style="color:#FFAEC0;text-decoration:underline;margin-left:6px;font-weight:700">📄 檢視Log</a>', 'wn', 6000);
      } else {
        tt('✅ 「'+name+'」Manifest 已成功更新為最新版本！ <a href="javascript:openManifestLogModal()" style="color:#A7F3D0;text-decoration:underline;margin-left:6px;font-weight:700">📄 檢視Log</a>', 'ok', 5500);
      }
    } else {
      var failMsg = (res && res.msg) ? res.msg : '下載逾時或來源無此檔案';
      tt('❌ 更新未果: ' + failMsg + ' <a href="javascript:openManifestLogModal()" style="color:#FFCDD2;text-decoration:underline;margin-left:8px;font-weight:700;cursor:pointer">📄 點此檢視診斷 Log 報告</a>', 'er', 9000);
      // 自動彈出診斷報告，方便使用者一目了然看見錯在哪裡
      if(res && res.report_markdown){
        openManifestLogModal(res);
      }
    }
  } catch(e) {
    if(ov) ov.remove(); else cp();
    tt('更新發生異常: ' + (e.message || e) + ' <a href="javascript:openManifestLogModal()" style="color:#FFCDD2;text-decoration:underline;margin-left:8px;font-weight:700">📄 檢視Log</a>', 'er', 8000);
  }
}

async function autoUpdateAll(){
  var updatables = _pre._games ? _pre._games.filter(function(g){ return g.has_update; }) : [];
  if(!updatables.length){
    tt('所有本機遊戲皆已是最新檔案！', 'ok');
    return;
  }
  if(!confirm('共有 '+updatables.length+' 款遊戲有最新 Manifest 可更新。\n\n是否立即執行批次自動更新？')) return;
  
  var success = 0;
  var failed = [];
  for(var i=0; i<updatables.length; i++){
    var g = updatables[i];
    var gName = g.name || g.appid;
    var pct = Math.round(((i + 1) / updatables.length) * 100);
    sp('批次更新中 ('+(i+1)+'/'+updatables.length+')', '正在更新「'+gName+'」…', pct);
    try {
      var r = await pywebview.api.auto_stock_after_import(g.appid);
      if(r && r.ok){
        success++;
        g.has_update = false;
        g.version_status = '最新版';
        if(r.msg && r.msg.indexOf('Ryuu') > -1 && r.msg.indexOf('Lua.tools') > -1){
          tt('⚡ 「'+gName+'」' + r.msg, 'wn', 3500);
        }
      } else {
        var reason = (r && r.msg) ? r.msg : '伺服器未收錄或下載逾時';
        failed.push({ appid: g.appid, name: gName, msg: reason });
      }
    } catch(err){
      console.error(err);
      failed.push({ appid: g.appid, name: gName, msg: (err && err.message) || String(err) });
    }
  }
  cp();
  if(_pre._games){
    _pre._games.sort(function(a,b){ return (b.has_update?1:0) - (a.has_update?1:0); });
    var filter = (document.getElementById('mf').value||'').trim().toLowerCase();
    renderGames(_pre._games, filter);
  }
  
  if(failed.length === 0){
    tt('✅ 批次更新完成！已成功更新全部 '+success+' 款遊戲。', 'ok');
  } else if(success > 0){
    var failNames = failed.slice(0, 3).map(function(f){ return f.name; }).join('、');
    if(failed.length > 3) failNames += ' 等 ' + failed.length + ' 款';
    tt('⚡ 批次更新結束：成功 '+success+' 款，失敗 '+failed.length+' 款（'+failNames+'）', 'wn');
  } else {
    var firstMsg = failed[0] ? failed[0].msg : '請檢查網路連線或憑證狀態';
    tt('❌ 批次更新失敗: ' + firstMsg, 'er');
  }
}

