#glist .card .card-dd, #results .card-dd{position:absolute;bottom:34px;top:auto;right:6px;background:rgba(255,255,255,.98);border-radius:10px;border:1px solid rgba(0,0,0,.12);box-shadow:0 10px 30px rgba(0,0,0,.25),0 2px 8px rgba(0,0,0,.1);padding:5px 0;z-index:1000!important;display:none;min-width:130px;max-height:240px;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
#glist .card .card-dd.show, #results .card-dd.show{display:block!important;animation:fadeInMenu .15s cubic-bezier(0.16,1,0.3,1)}
@keyframes fadeInMenu{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
#glist .card .card-dd button, #results .card-dd button{display:flex;align-items:center;gap:7px;width:100%;padding:7px 14px;border:none;background:transparent;font-size:11.5px;font-weight:600;font-family:var(--font);cursor:pointer;text-align:left;color:var(--dark);margin:0;white-space:nowrap;transition:background .15s,color .15s;box-sizing:border-box}
