  line-height: 1.25;
  white-space: nowrap;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  letter-spacing: 0.2px;
}
.corner-tag.tag-of {
  background: linear-gradient(135deg, #00BCD4, #00838F) !important;
  box-shadow: 0 2px 6px rgba(0, 188, 212, 0.45) !important;
}
/* 🌟 依使用者需求：部署與保護不需要鮮豔顏色，採用低調乾淨的半透明深色膠囊 */
.corner-tag.tag-dep {
  background: rgba(0, 0, 0, 0.72) !important;
  border: 1px solid rgba(255, 255, 255, 0.22) !important;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.45) !important;
  color: #ffffff !important;
}
.corner-tag.tag-lock {
  background: rgba(0, 0, 0, 0.72) !important;
  border: 1px solid rgba(255, 255, 255, 0.22) !important;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.45) !important;
  color: #ffffff !important;
}
.corner-tag.tag-up {
  background: linear-gradient(135deg, #FF9800, #F57C00) !important;
  box-shadow: 0 2px 6px rgba(245, 124, 0, 0.45) !important;
  animation: pulseBadge 1.5s infinite ease-in-out;
}
#glist.list .card-corner-tags {
  position: static;
  flex-direction: row;
  align-items: center;
  gap: 6px;
  margin-right: 12px;
}
.batch-up-btn {
  background: linear-gradient(135deg, #FF9800, #F57C00) !important;
  color: #fff !important;
  font-weight: bold;
}
.batch-up-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(245, 124, 0, 0.4);
}

/* 🌟 雲存檔既有存檔清單櫻花流光小卡樣式 (動畫與遊戲小卡一致，精簡名稱、圖片、儲存時間) */
.cloud-saves-section {
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px dashed rgba(255, 182, 193, 0.45);
}
.cloud-saves-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 14px;
  margin-top: 10px;
}
.cs-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  text-align: left;
  padding: 0;
  border-radius: 14px;
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--pink-light);
  box-shadow: 0 4px 14px rgba(255, 102, 153, 0.08);
  cursor: pointer;
  overflow: hidden;
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s, border-color 0.22s;
}
.cs-card:hover {
  transform: translateY(-4px);
  border-color: var(--pink-deep);
  box-shadow: 0 10px 24px rgba(255, 102, 153, 0.22), 0 0 14px rgba(255, 182, 193, 0.35);
}
.cs-card img {
  width: 100%;
  height: 85px;
  object-fit: cover;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.08);
  display: block;
  transition: transform 0.35s ease;
}
.cs-card:hover img {
  transform: scale(1.05);
}
.cs-card-body {
  padding: 8px 10px 10px;
  background: var(--card-text-bg, rgba(0, 0, 0, 0.65));
  display: flex;
  flex-direction: column;
  gap: 4px;
  border-bottom-left-radius: 13px;
  border-bottom-right-radius: 13px;
}
.app.dark .cs-card-body {
  background: rgba(30, 22, 26, 0.92);
}
.cs-name {
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #fff;
  margin: 0;
  line-height: 1.3;
}
.cs-time {
  font-size: 10.5px;
  color: #FFE066;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 4px;
  margin: 0;
}
.cs-empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: 36px 20px;
  color: var(--gray);
  font-size: 12px;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12px;
  border: 1px dashed var(--pink-light);
}

/* 🌟 搜尋遊戲小卡中間區域真實進度條動畫樣式 (靠左延展，完整展示長文案與網速) */
.card-progress-wrap {
  flex: 1 1 auto;
  min-width: 180px;
  max-width: 650px;
  margin: 0 16px 0 6px;
  display: none;
  flex-direction: column;
  gap: 4px;
  text-align: left;
  animation: fadeIn 0.25s ease;
}
.card-progress-wrap.active {
  display: flex !important;
}
.card-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 11.5px;
  line-height: 1.2;
  gap: 8px;
}
.cp-action {
  color: var(--fg);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1 1 auto;
  min-width: 0;
  letter-spacing: 0.1px;
}
.cp-percent {
  font-size: 11.5px;
  font-weight: 700;
  color: #00bcd4;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  margin-left: 4px;
}
.card-progress-track {
  width: 100%;
  height: 6px;
  background: rgba(0, 0, 0, 0.28);
  border-radius: 4px;
  overflow: hidden;
  position: relative;
  box-shadow: inset 0 1px 2px rgba(0,0,0,0.3);
}
.card-progress-bar {
  height: 100%;
  width: 0%;
  border-radius: 4px;
  background: linear-gradient(90deg, #00bcd4 0%, #2196f3 50%, #9c27b0 100%);
  background-size: 200% 100%;
  animation: shimmerFlow 2s linear infinite;
  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), background 0.3s;
  box-shadow: 0 0 8px rgba(0, 188, 212, 0.5);
}
.card-progress-bar.error {
  background: linear-gradient(90deg, #ff5252, #d32f2f) !important;
  box-shadow: 0 0 8px rgba(244, 67, 54, 0.6) !important;
  animation: none !important;
}
.card-progress-bar.success {
  background: linear-gradient(90deg, #4caf50, #2e7d32) !important;
  box-shadow: 0 0 8px rgba(76, 175, 80, 0.6) !important;
}
@keyframes shimmerFlow {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* 🌟 網格卡片專屬：圓形進度環 Overlay (降低背景圖片亮度、居中圓形進度與文字) */
.card-circle-overlay {
  position: absolute !important;
  inset: 0 !important;
  background: rgba(12, 8, 10, 0.82) !important;
  backdrop-filter: blur(4px) !important;
  -webkit-backdrop-filter: blur(4px) !important;
  border-radius: 13px !important;
  z-index: 50 !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 10px !important;
  text-align: center !important;
  color: #fff !important;
  animation: fadeIn .2s cubic-bezier(0.16, 1, 0.3, 1) !important;
  box-sizing: border-box !important;
  pointer-events: auto !important;
}
.card-circle-overlay .circle-box {
  position: relative !important;
  width: 48px !important;
  height: 48px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin-bottom: 6px !important;
}
.card-circle-overlay .circle-svg {
  width: 48px !important;
  height: 48px !important;
  transform: rotate(-90deg) !important;
}
.card-circle-overlay .circle-bg-ring {
  fill: none !important;
  stroke: rgba(255, 255, 255, 0.15) !important;
  stroke-width: 3.5 !important;
}
.card-circle-overlay .circle-bar-ring {
  fill: none !important;
  stroke: #00bcd4 !important;
  stroke-width: 3.5 !important;
  stroke-linecap: round !important;
  transition: stroke-dashoffset 0.3s cubic-bezier(0.4, 0, 0.2, 1), stroke 0.3s !important;
}
.card-circle-overlay .circle-bar-ring.error {
  stroke: #ff5252 !important;
}
.card-circle-overlay .circle-bar-ring.success {
  stroke: #4caf50 !important;
}
.card-circle-overlay .circle-pct-text {
  position: absolute !important;
  font-size: 11px !important;
  font-weight: 800 !important;
  color: #fff !important;
  font-variant-numeric: tabular-nums !important;
  text-shadow: 0 1px 3px rgba(0,0,0,0.9) !important;
}
.card-circle-overlay .circle-action-text {
  font-size: 10.5px !important;
  font-weight: 600 !important;
  color: #ffd700 !important;
  line-height: 1.35 !important;
  max-width: 155px !important;
  word-break: break-word !important;
  text-shadow: 0 1px 4px rgba(0,0,0,0.9) !important;
  margin-top: 2px !important;
}

/* 視覺調節滑桿樣式 */
.setting-slider-row{padding:9px 0;border-bottom:1px solid var(--border)}
.setting-slider-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;font-size:12px}
.setting-slider-header .val{font-size:11px;font-weight:700;color:var(--pink-deep);min-width:44px;text-align:right}
.setting-slider-row input[type=range]{width:100%;height:6px;border-radius:3px;background:var(--pink-pale);outline:none;-webkit-appearance:none;cursor:pointer;accent-color:var(--pink-deep);margin:4px 0}
.setting-slider-row input[type=range]::-webkit-slider-thumb{width:16px;height:16px;border-radius:50%;background:var(--pink-deep);cursor:pointer;-webkit-appearance:none;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.2)}
.app.dark .setting-slider-row input[type=range]{background:rgba(255,255,255,.1)}

/* 獨立高階背景圖層 (支援 GIF 動圖、磨砂毛玻璃與透明度) */
/* 視窗透明度由後端 Win32 SetLayeredWindowAttributes 實體控制穿透桌面 */
.app{opacity:1}
.app-bg-layer{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.app-bg-img{position:absolute;inset:-30px;background-size:cover;background-position:center;background-repeat:no-repeat;filter:blur(var(--bg-blur,0px));opacity:var(--bg-opacity,0.8);transition:filter .15s,opacity .15s}
.app-bg-overlay{position:absolute;inset:0;background:transparent;pointer-events:none}
.app.dark .app-bg-overlay{background:rgba(25,20,23,.35)}
/* ═══════════════════════════════════════════════════════
   遊戲詳細資料彈窗 (主框架漸顯動效 + 毛玻璃)
   ═══════════════════════════════════════════════════════ */
.card{cursor:pointer}
.detail-modal-overlay{position:fixed;inset:0;background:rgba(45,37,40,.48);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);z-index:9999;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s cubic-bezier(.16,1,.3,1)}
.detail-modal-overlay.active{opacity:1;pointer-events:auto}
.detail-modal-box{background:rgba(255,255,255,.92);border:1.5px solid rgba(255,183,197,.75);border-radius:22px;box-shadow:0 18px 45px rgba(61,44,46,.2),inset 0 1px 0 rgba(255,255,255,.95);backdrop-filter:blur(24px) saturate(1.2);-webkit-backdrop-filter:blur(24px) saturate(1.2);width:860px;max-width:94vw;height:85vh;max-height:88vh;display:flex;flex-direction:column;overflow:hidden;transform:scale(.92) translateY(14px);transition:transform .28s cubic-bezier(.16,1,.3,1)}
.detail-modal-overlay.active .detail-modal-box{transform:scale(1) translateY(0)}
.detail-modal-header{display:flex;align-items:center;justify-content:space-between;padding:14px 20px 10px;border-bottom:1px solid rgba(255,183,197,.35)}
.detail-modal-title{font-size:15px;font-weight:700;color:var(--dark);letter-spacing:.5px}
.detail-close-btn{background:transparent;border:none;font-size:16px;color:var(--gray);cursor:pointer;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:background .2s,color .2s}
.detail-close-btn:hover{background:rgba(255,183,197,.25);color:var(--pink-deep)}
.detail-modal-body{display:flex;padding:16px 22px 20px;gap:22px;overflow:hidden;flex:1;min-height:0}
.detail-left-col{width:250px;flex-shrink:0;display:flex;flex-direction:column;align-items:center;text-align:center;overflow-y:auto;overflow-x:hidden;max-height:100%;padding-right:6px;scroll-behavior:smooth;box-sizing:border-box}
.detail-img-box{width:100%;aspect-ratio:460/215;height:116px;min-height:116px;max-height:116px;border-radius:12px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.12);margin-bottom:12px;background:rgba(0,0,0,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0 !important}
.detail-img-box img{width:100%;height:100%;object-fit:cover;display:block}
.detail-name{font-size:15px;font-weight:700;color:var(--dark);margin-bottom:6px;line-height:1.35;word-break:break-word;flex-shrink:0}
.detail-aid-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(255,183,197,.2);border:1px solid rgba(255,183,197,.5);border-radius:99px;padding:3px 10px;font-size:11px;color:var(--dark);margin-bottom:10px;flex-shrink:0}
.btn-copy-aid{background:transparent;border:none;cursor:pointer;font-size:11px;padding:0;color:var(--pink-deep)}
.detail-status-pill{display:none !important}
.detail-sources-box{flex-shrink:0;width:100%}
.detail-actions{display:flex;flex-direction:column;gap:8px;width:100%;flex-shrink:0;margin-top:12px;padding-bottom:8px}
.detail-actions button{width:100%;justify-content:center}
/* 圖一需求：按鈕配色使用黑色字體，清晰醒目 */
#dt-btn-action, #dt-btn-action:hover, #dt-btn-action:focus, #dt-btn-action:active{
  color: #111111 !important;
  font-weight: 700 !important;
  letter-spacing: .3px;
}
.app.dark #dt-btn-action, .app.dark #dt-btn-action:hover, .app.dark #dt-btn-action:focus{
  color: #111111 !important;
}

.detail-right-col{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0}
.detail-right-header{margin-bottom:8px}
.detail-section-title{font-size:13px;font-weight:700;color:var(--dark)}
.detail-section-sub{font-size:10px;color:var(--gray);margin-top:2px}

/* 圖三需求：Depot 子分類導航切換鈕 (多 DLC/Depot 分流，支援滾輪左右滑動) */
.detail-depot-tabs{display:flex;gap:6px;margin-bottom:10px;overflow-x:auto;overflow-y:hidden;padding-bottom:5px;scroll-behavior:smooth;white-space:nowrap;flex-wrap:nowrap;-webkit-overflow-scrolling:touch}
.detail-depot-tabs::-webkit-scrollbar{height:4px !important}
.dt-depot-btn{padding:5px 12px;border-radius:99px;font-size:11px;font-weight:600;border:1px solid rgba(255,183,197,.55);background:rgba(255,255,255,.65);color:var(--dark);cursor:pointer;transition:all .18s;white-space:nowrap;user-select:none;flex-shrink:0}
.dt-depot-btn:hover{background:var(--pink-pale);border-color:var(--pink);transform:translateY(-1px)}
.dt-depot-btn.active{background:linear-gradient(135deg,var(--pink),var(--pink-deep));color:#111111;font-weight:700;border-color:transparent;box-shadow:0 2px 8px rgba(255,130,160,.3)}
.app.dark .dt-depot-btn{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.12);color:#D5C8CC}
.app.dark .dt-depot-btn.active{background:linear-gradient(135deg,#FFAEC0,#E07A98);color:#111111}

.detail-manifest-list{flex:1;min-height:0;overflow-y:auto;padding-right:5px;display:flex;flex-direction:column;gap:7px}
.dt-loading-skeleton{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 0;gap:10px;color:var(--gray);font-size:12px}
.dt-item{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-radius:10px;background:rgba(255,255,255,.65);border:1px solid rgba(0,0,0,.06);transition:all .2s;cursor:pointer;min-height:38px;box-sizing:border-box}
.dt-item:hover{background:rgba(255,255,255,.95);transform:translateX(3px);border-color:rgba(255,183,197,.6)}
.dt-item-left{display:flex;align-items:center;min-width:0}
.dt-gid{font-family:Consolas,Monaco,monospace;font-size:12.5px;font-weight:700;color:var(--dark);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dt-gid-date{font-size:11px;color:#718096;margin-left:8px;font-family:Consolas,Monaco,monospace;font-weight:600;display:inline-flex;align-items:center;opacity:0.9}
.app.dark .dt-gid-date{color:#A0AEC0}
.dt-tag{font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:6px;white-space:nowrap;flex-shrink:0}
/* 藍色標註：當前本地儲存的 manifest 版本 */
.dt-item.dt-current{background:rgba(227,242,253,.85);border:1.5px solid #42A5F5;box-shadow:0 2px 8px rgba(33,150,243,.18)}
.dt-tag.dt-tag-blue{background:#1E88E5;color:#fff;box-shadow:0 1px 4px rgba(30,136,229,.35)}
/* 黃色標註：即將更新的 manifest 版本 */
.dt-item.dt-pending{background:rgba(255,248,225,.90);border:1.5px solid #FFCA28;box-shadow:0 2px 8px rgba(255,193,7,.2)}
.dt-tag.dt-tag-yellow{background:#FF8F00;color:#fff;box-shadow:0 1px 4px rgba(255,143,0,.35)}

/* ═══════════════════════════════════════════════════════
   Manifest 更新全鏈路診斷報告視窗 (櫻花暗黑流光風格)
   ═══════════════════════════════════════════════════════ */
.log-modal-box {
  width: 960px;
  max-width: 95vw;
  height: 85vh;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
}
.log-modal-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 20px;
  background: rgba(255, 183, 197, 0.15);
  border-bottom: 1px solid rgba(255, 183, 197, 0.3);
  font-size: 12px;
}
.app.dark .log-modal-toolbar {
  background: rgba(255, 255, 255, 0.04);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
.log-modal-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 12px;
  color: var(--dark);
  font-weight: 600;
}
.app.dark .log-modal-meta {
  color: #ECEFF4;
}
.log-modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 18px 24px;
  background: #FFFFFF;
  color: #1E293B;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 13px;
  line-height: 1.6;
}
.app.dark .log-modal-body {
  background: #131017;
  color: #F1F5F9;
}

/* 粗體文字：淺色深黑字、深色純白字 */
.log-modal-body b, .log-modal-body strong {
  font-weight: 700;
  color: #0F172A;
}
.app.dark .log-modal-body b, .app.dark .log-modal-body strong {
  color: #FFFFFF;
}

/* 標題層級：淺色深莓紅/藍黑、深色粉櫻/冰藍 */
.log-modal-body h1, .log-modal-body .log-title {
  color: #BE185D;
  margin-top: 14px;
  margin-bottom: 8px;
  font-weight: 700;
  font-size: 16px;
}
.app.dark .log-modal-body h1, .app.dark .log-modal-body .log-title {
  color: #FFAEC0;
}

.log-modal-body h2, .log-modal-body .log-section-title {
  color: #9D174D;
  border-bottom: 1.5px solid rgba(255, 183, 197, 0.45);
  padding-bottom: 6px;
  font-size: 14px;
  margin-top: 16px;
  margin-bottom: 8px;
  font-weight: 700;
}
.app.dark .log-modal-body h2, .app.dark .log-modal-body .log-section-title {
  color: #FBCFE8;
  border-bottom-color: rgba(255, 183, 197, 0.25);
}

.log-modal-body h3, .log-modal-body h4, .log-modal-body .log-sub-title {
  font-size: 13px;
  color: #1D4ED8;
  margin-top: 10px;
  margin-bottom: 4px;
  font-weight: 600;
}
.app.dark .log-modal-body h3, .app.dark .log-modal-body h4, .app.dark .log-modal-body .log-sub-title {
  color: #93C5FD;
}

/* 引用提示塊 */
.log-quote {
  border-left: 3.5px solid #F472B6;
  padding: 6px 12px;
  margin: 10px 0;
  background: rgba(255, 183, 197, 0.15);
  color: #831843;
  font-size: 12.5px;
  border-radius: 0 6px 6px 0;
}
.app.dark .log-quote {
  background: rgba(244, 114, 182, 0.1);
  color: #F9A8D4;
}

/* 表格：淺色淺粉底黑字、深色暗灰底白字 */
.log-table {
  width: 100%;
  border-collapse: collapse;
  margin: 12px 0 16px;
  font-size: 12px;
}
.log-table th, .log-table td {
  border: 1px solid rgba(255, 183, 197, 0.45);
  padding: 7px 10px;
  text-align: left;
}
.log-table th {
  background: rgba(255, 183, 197, 0.22);
  color: #0F172A;
  font-weight: 700;
}
.log-table td {
  color: #334155;
}
.log-table tr:nth-child(even) {
  background: rgba(255, 183, 197, 0.08);
}
.log-table tr:hover {
