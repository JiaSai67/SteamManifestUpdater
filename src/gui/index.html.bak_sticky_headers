<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<script>
(function(){
  try {
    var s = localStorage.getItem('ui_font_size') || 'small';
    if(s === 'normal') {
      document.documentElement.classList.add('font-normal');
    } else {
      document.documentElement.classList.add('font-small');
    }
    // 🌟 首要關鍵：網頁解析第 0 毫秒立即判斷深色模式，杜絕啟動白閃
    var isDark = localStorage.getItem('dark_mode') === '1' || document.documentElement.classList.contains('dark');
    if(isDark){
      document.documentElement.classList.add('dark');
      if(document.body) document.body.classList.add('dark');
    }
  } catch(e){}
})();
</script>
<style>
/* 🌟 深色模式最高優先底色宣告（防止 HTML 解析與視窗渲染時閃白） */
html.dark, html.dark body {
  background: linear-gradient(135deg, #231C1E 0%, #2A2124 35%, #1E1719 70%, #251D20 100%) !important;
  color: #D5C8CC !important;
}
html.dark .app {
  background: linear-gradient(135deg, #231C1E 0%, #2A2124 35%, #1E1719 70%, #251D20 100%) !important;
  color: #D5C8CC !important;
}
html.dark .splash-overlay {
  background: linear-gradient(135deg, #231C1E 0%, #2A2124 35%, #1E1719 70%, #251D20 100%) !important;
}

:root{--pink:#FFB7C5;--pink-deep:#FF8FA7;--pink-light:#FFD1DC;--pink-pale:#FFF0F3;--white:#FFF;--dark:#3D2C2E;--gray:#9B8E8F;--err:#FF6B6B;--succ:#6ECB63;--card:rgba(255,255,255,0.15);--border:rgba(240,224,227,0.6);--font:'Microsoft YaHei',sans-serif;--r:12px;--rs:8px}
html,body{margin:0;padding:0;overflow:hidden;background:linear-gradient(135deg,#FFE2E7 0%,#FFE9ED 30%,#FFD8DF 60%,#FFE2E7 100%)}body{font-family:var(--font);color:var(--dark);user-select:none;min-width:880px;min-height:580px}.app{display:flex;flex-direction:column;height:100vh;width:100vw;min-width:880px;min-height:580px;background:linear-gradient(135deg,#FFE2E7 0%,#FFE9ED 30%,#FFD8DF 60%,#FFE2E7 100%);background-size:cover;background-position:center}.app.has-bg{position:relative}.app.has-bg::before{content:'';position:fixed;inset:0;background:transparent;pointer-events:none;z-index:0;display:none}.app::after{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;opacity:0}.app.has-bg .titlebar,.app.has-bg .body-row{position:relative;z-index:1}.titlebar{height:32px;display:flex;align-items:center;justify-content:space-between;padding:0 4px 0 8px;flex-shrink:0;z-index:10;background:rgba(255,255,255,.45);user-select:none;cursor:default;-webkit-app-region:drag;}.titlebar .tt{font-size:11px;font-weight:600;color:var(--dark);pointer-events:none;-webkit-app-region:drag;}.titlebar .btns{position:relative;z-index:60;display:flex;-webkit-app-region:no-drag;pointer-events:auto;}.titlebar .btns button{width:34px;height:24px;border:none;background:transparent;border-radius:4px;font-size:10px;cursor:pointer;color:var(--dark);-webkit-app-region:no-drag;pointer-events:auto;}.titlebar .btns button:hover{background:rgba(0,0,0,.08)}.titlebar .btns .bc:hover{background:var(--err);color:var(--white)}.body-row{display:flex;flex:1;overflow:hidden;-webkit-app-region:no-drag}
.sidebar{width:48px;position:relative;z-index:100;display:flex;flex-direction:column;align-items:center;background:rgba(255,255,255,.45);border-right:1px solid var(--border);padding:10px 0;-webkit-app-region:no-drag;pointer-events:auto}
.sidebar button{width:36px;height:36px;position:relative;z-index:101;border:none;border-radius:10px;font-size:18px;cursor:pointer;background:transparent;margin:2px 0;color:var(--dark);-webkit-app-region:no-drag;pointer-events:auto}
.sidebar button:hover{background:var(--pink-light)}
.sidebar button.locked{position:relative;opacity:0.25!important;cursor:not-allowed!important;filter:grayscale(90%)!important}
.sidebar button.locked:hover{background:transparent!important;transform:none!important}
.sidebar button.locked:hover::after{content:attr(data-tooltip);position:absolute;left:44px;top:50%;transform:translateY(-50%);background:rgba(45,30,32,0.92);color:#fff;padding:6px 11px;font-size:11.5px;font-weight:700;border-radius:6px;white-space:nowrap;box-shadow:0 4px 14px rgba(0,0,0,0.3);pointer-events:none;z-index:9999;animation:fadeInTooltip .15s ease-out}
@keyframes fadeInTooltip{from{opacity:0;transform:translateY(-50%) translateX(-4px)}to{opacity:1;transform:translateY(-50%) translateX(0)}}
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;-webkit-app-region:no-drag;padding-right:16px}
.pages{flex:1;overflow-y:auto;padding:16px 20px}

.page{display:none}.page.active{display:block;animation:fadeIn .2s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
h2{font-size:20px;font-weight:700;margin-bottom:12px}
.search-row{display:flex;gap:6px;margin-bottom:12px}
.search-row input{flex:1;padding:10px 16px;border:2px solid var(--pink-light);border-radius:18px;font-size:14px;font-family:var(--font);outline:none;background:var(--white);color:var(--dark)}
.search-row input:focus{border-color:var(--pink-deep)}
.btn{padding:8px 18px;border:none;border-radius:var(--r);font-size:13px;font-weight:600;font-family:var(--font);cursor:pointer;transition:.2s;white-space:nowrap}
.btn-p{background:linear-gradient(135deg,var(--pink),var(--pink-deep));color:var(--white)}
.btn-p:hover{transform:translateY(-1px)}.btn-p:disabled{opacity:.55;transform:none}
.btn-o{background:var(--white);border:1.5px solid var(--pink);color:var(--pink-deep)}.btn-o:hover{background:var(--pink-pale)}
.btn-d{background:var(--err);color:var(--white)}.btn-d:hover{background:#FF5252}
.btn-manifest-diag{display:inline-flex;align-items:center;gap:4px;background:rgba(255,183,197,.2);border:1px solid rgba(255,183,197,.45);color:#111827;font-weight:600;cursor:pointer;transition:all .2s ease}
.btn-manifest-diag:hover{background:rgba(255,183,197,.35)}
.card{display:flex;align-items:center;gap:12px;padding:15px 12px;background:var(--card);border:1px solid var(--border);border-radius:var(--rs);margin-bottom:4px;transition:.2s;box-shadow:inset 0 1px 0 rgba(255,255,255,.8),0 2px 12px rgba(61,44,46,.05)}
.card:hover{background:var(--pink-pale);border-color:var(--pink)}
.card img{width:120px;height:56px;border-radius:4px;object-fit:cover;flex-shrink:0;background:rgba(255,255,255,.1)}
/* 管理頁網格 */
#glist{display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:12px}
#glist .card{flex-direction:column;align-items:stretch;text-align:center;padding:0;overflow:visible!important;border-radius:14px;min-height:auto;position:relative;gap:0}
#glist .card img{width:100%;height:85px;object-fit:cover;flex-shrink:0;background:rgba(255,255,255,.08);border-top-left-radius:13px;border-top-right-radius:13px;display:block}
#glist .card .name{font-size:12px;font-weight:600;padding:7px 10px 3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0;background:var(--card-text-bg, rgba(0,0,0,.65));color:#fff;transition:background .15s}
