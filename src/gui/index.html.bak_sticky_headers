#results.browse-grid .card .name{font-size:12.5px;font-weight:600;padding:7px 10px 3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0;background:var(--card-text-bg, rgba(0,0,0,.65));color:#fff;transition:background .15s}
#results.browse-grid .card .aid{font-size:11px;color:#ddd;padding:3px 32px 5px 10px;margin:0;font-variant-numeric:tabular-nums;background:var(--card-text-bg, rgba(0,0,0,.65));border-bottom-left-radius:13px;border-bottom-right-radius:13px;transition:background .15s;display:flex;align-items:center;justify-content:center;min-height:24px;box-sizing:border-box;position:relative}

#results.browse-grid .card .aid .aid-num{font-size:11px;color:#ddd;font-variant-numeric:tabular-nums;letter-spacing:0.2px}
#results.browse-grid .card.needs-update .aid .aid-num{color:#FFE066 !important;font-weight:700}
#results.browse-grid .card .card-menu{position:absolute;bottom:6px;right:6px;width:24px;height:24px;border-radius:50%;background:rgba(0,0,0,.45);color:#fff;font-size:14px;line-height:24px;text-align:center;cursor:pointer;border:none;z-index:4;transition:background .2s,transform .15s}
#results.browse-grid .card .card-menu:hover{background:var(--pink-deep);transform:scale(1.08)}
#results.browse-grid .card .card-menu svg{display:block;margin:auto}
.card-menu.card-installed{background:rgba(46,204,113,.92) !important;color:#fff !important;cursor:default !important;box-shadow:0 2px 8px rgba(46,204,113,.4) !important}
